# Public base URLs used by the shared header. NEXT_PUBLIC_CONSOLE_URL is
# also the Better Auth client baseURL the web app reads the cross-origin
# session from (the console must list this web origin in
# BETTER_AUTH_TRUSTED_ORIGINS + set BETTER_AUTH_COOKIE_DOMAIN).
NEXT_PUBLIC_WEB_URL=https://bitrouter.ai
NEXT_PUBLIC_CONSOLE_URL=https://cloud.bitrouter.ai

# Real agent inference. No sample fallback. Keep keys server-only and qualify
# the dedicated credential's Cloud funding/spend controls before enabling.
BITROUTER_PLAYGROUND_ENABLED=0
BITROUTER_PLAYGROUND_API_KEY=
# Explicit tool-capable Cloud catalog model ID; qualify it on the target service.
BITROUTER_PLAYGROUND_MODEL=
BITROUTER_PLAYGROUND_VISION_MODEL=
# Durable shared Redis REST quota store; use the same ID/store on every replica.
# Request counts do not expire or refund. These are not dollar spending caps.
BITROUTER_PLAYGROUND_REDIS_REST_URL=
BITROUTER_PLAYGROUND_REDIS_REST_TOKEN=
BITROUTER_PLAYGROUND_QUOTA_ID=
BITROUTER_PLAYGROUND_SITE_REQUEST_LIMIT=
BITROUTER_PLAYGROUND_ACCOUNT_REQUEST_LIMIT=
BITROUTER_PLAYGROUND_MAX_CONCURRENCY=
# Optional development-only operator bypass, bound to 127.0.0.1. Never in production.
BITROUTER_PLAYGROUND_LOCAL_LIVE=0

# Optional Enterprise contact form. Configure a sending API key and verified
# sender on the Railway site service to deliver inquiries to contact@bitrouter.ai.
RESEND_API_KEY=
RESEND_ENTERPRISE_FROM=

# Public status page. Use a read-only OpenStatus key on the website server.
OPENSTATUS_API_KEY=
OPENSTATUS_PAGE_ID=
OPENSTATUS_COMPONENT_ID=
